{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NaYan",
  "version": "0.3.1",
  "identifier": "com.nayan.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "纳言 · 建议收件箱",
        "url": "index.html",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 26,
          "y": 28
        },
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600
      },
      {
        "label": "capture",
        "title": "收进收件箱",
        "url": "capture-mini.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "width": 560,
        "height": 580
      },
      {
        "label": "cliphud",
        "title": "剪贴板收录",
        "url": "cliphud.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "width": 400,
        "height": 208,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/nayan-ocr"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
